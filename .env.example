APP_NAME=FlowMind
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
APP_ENCRYPTION_KEY=
PUBLIC_BASE_URL=http://localhost:8020
WEB_BASE_URL=http://localhost:5180
SIGNUP_MODE=open
AUTO_VERIFY_EMAIL=true
SEED_DEMO=true

DATABASE_URL=sqlite+aiosqlite:///./flowmind.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
RUN_INLINE=true
AUTO_CREATE_TABLES=true

CORS_ORIGINS=http://localhost:5173,http://localhost:5180,http://localhost:8020

SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@flowmind.local
SMTP_TLS=false

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=flowmind
MINIO_SECRET_KEY=flowmind-secret
MINIO_BUCKET=flowmind
MINIO_SECURE=false
LOCAL_STORAGE_DIR=./data/uploads

RUNNER_URL=http://localhost:9100
RUNNER_HMAC_SECRET=change-runner-secret

DEFAULT_CHAT_BASE_URL=http://localhost:11434/v1
DEFAULT_CHAT_API_KEY=
DEFAULT_CHAT_MODEL=qwen2.5:7b
DEFAULT_EMBEDDING_BASE_URL=http://localhost:11434/v1
DEFAULT_EMBEDDING_API_KEY=
DEFAULT_EMBEDDING_MODEL=bge-m3
DEFAULT_EMBEDDING_DIMENSION=1024

OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

RUN_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365


